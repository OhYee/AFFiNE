#
# All-in-one build Dockerfile for AFFiNE (Linux/amd64).
# Compiles everything inside Docker — no local Rust/Node toolchain needed.
#
# Usage:
#   docker build --platform linux/amd64 \
#     -f .github/deployment/node/Dockerfile.all-in-one \
#     -t affine:latest .
#
# With registry mirror (for China):
#   docker build --platform linux/amd64 \
#     --build-arg REGISTRY_MIRROR=docker.m.daocloud.io/ \
#     -f .github/deployment/node/Dockerfile.all-in-one \
#     -t affine:latest .

ARG REGISTRY_MIRROR=

# ============================================================
# Stage 1: Build server-native (Rust → .node binary)
# ============================================================
FROM ${REGISTRY_MIRROR}rust:1.93-bookworm AS rust-builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      clang lld pkg-config libssl-dev \
      curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    corepack enable && corepack prepare yarn@4.12.0 --activate && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY packages/backend/native packages/backend/native
COPY packages/common packages/common

COPY package.json .yarnrc.yml yarn.lock ./
COPY .yarn .yarn

RUN yarn workspaces focus @affine/server-native --production=false 2>/dev/null || true

ENV CC="clang -D_BSD_SOURCE"
ENV TARGET_CC="clang -D_BSD_SOURCE"

RUN cd packages/backend/native && \
    npx @napi-rs/cli build --release --strip --no-const-enum \
      --target x86_64-unknown-linux-gnu && \
    mv server-native.node server-native.x64.node

# ============================================================
# Stage 2: Build frontend + server (Node.js)
# ============================================================
FROM ${REGISTRY_MIRROR}node:22-bookworm AS node-builder

WORKDIR /build

COPY package.json .yarnrc.yml yarn.lock .nvmrc ./
COPY .yarn .yarn
COPY tools tools
COPY packages packages
COPY blocksuite blocksuite
COPY tests tests

RUN corepack enable && corepack prepare yarn@4.12.0 --activate

RUN YARN_ENABLE_SCRIPTS=0 yarn install --mode=skip-build

ARG BUILD_TYPE=canary
ENV BUILD_TYPE=${BUILD_TYPE}

RUN yarn affine @affine/web build
RUN yarn affine @affine/admin build
RUN yarn affine @affine/mobile build

COPY --from=rust-builder /build/packages/backend/native/server-native.x64.node \
     packages/backend/native/server-native.x64.node

RUN touch packages/backend/native/server-native.arm64.node && \
    touch packages/backend/native/server-native.armv7.node

RUN yarn workspace @affine/server build

RUN yarn workspaces focus @affine/server --production && \
    yarn workspace @affine/server prisma generate && \
    mv node_modules packages/backend/server/

# ============================================================
# Stage 3: Assemble final image (same as official Dockerfile)
# ============================================================
FROM ${REGISTRY_MIRROR}node:22-bookworm-slim AS assets
WORKDIR /app

COPY --from=node-builder /build/packages/backend/server /app
COPY --from=node-builder /build/packages/frontend/apps/web/dist /app/static
COPY --from=node-builder /build/packages/frontend/admin/dist /app/static/admin
COPY --from=node-builder /build/packages/frontend/apps/mobile/dist /app/static/mobile

ARG TARGETARCH=amd64
ARG TARGETVARIANT
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN AFFINE_DOCKER_CLEAN=1 TARGETARCH="${TARGETARCH}" TARGETVARIANT="${TARGETVARIANT}" \
    node ./scripts/docker-clean.mjs

FROM ${REGISTRY_MIRROR}node:22-bookworm-slim
WORKDIR /app

COPY --from=assets /app /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl libjemalloc2 && \
    rm -rf /var/lib/apt/lists/*

ENV LD_PRELOAD=libjemalloc.so.2

EXPOSE 3010

CMD ["node", "./dist/main.js"]
